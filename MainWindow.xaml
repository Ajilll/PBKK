<Window x:Class="StudentRegistrationWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portal Registrasi Mahasiswa" Height="550" Width="600" WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F6FA" Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Kolom Form -->
            <ColumnDefinition Width="*"/>
            <!-- Kolom Hasil -->
        </Grid.ColumnDefinitions>

        <!-- BAGIAN KIRI: Form Input -->
        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="Form Pendaftaran" FontSize="20" FontWeight="Bold" Foreground="#2F3640" Margin="0,0,0,15"/>

            <TextBlock Text="Nama Lengkap:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNama" Height="25" Padding="2" Margin="0,0,0,10"/>

            <TextBlock Text="NRP:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNrp" Height="25" Padding="2" Margin="0,0,0,10"/>

            <TextBlock Text="Departemen:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbDepartemen" Height="25" Margin="0,0,0,10">
                <ComboBoxItem Content="Teknik Informatika" IsSelected="True"/>
                <ComboBoxItem Content="Sistem Informasi"/>
                <ComboBoxItem Content="Teknologi Informasi"/>
                <ComboBoxItem Content="Teknik Komputer"/>
            </ComboBox>

            <TextBlock Text="Tanggal Lahir:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <DatePicker x:Name="dpTanggalLahir" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Jalur Masuk:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <RadioButton x:Name="rbSNBP" Content="SNBP" Margin="0,0,10,0" IsChecked="True"/>
                <RadioButton x:Name="rbSNBT" Content="SNBT" Margin="0,0,10,0"/>
                <RadioButton x:Name="rbMandiri" Content="Mandiri"/>
            </StackPanel>

            <!-- Tombol Action -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="btnDaftar" Content="Daftar" Background="#4CD137" Foreground="White" FontWeight="Bold" Height="30" Margin="0,0,5,0" Click="BtnDaftar_Click" Cursor="Hand"/>
                <Button Grid.Column="1" x:Name="btnClear" Content="Bersihkan" Background="#E84118" Foreground="White" FontWeight="Bold" Height="30" Margin="5,0,0,0" Click="BtnClear_Click" Cursor="Hand"/>
            </Grid>
        </StackPanel>

        <!-- BAGIAN KANAN: Daftar Mahasiswa Terdaftar -->
        <Border Grid.Column="1" Background="White" CornerRadius="5" Padding="10">
            <StackPanel>
                <TextBlock Text="Mahasiswa Terdaftar" FontSize="16" FontWeight="Bold" Foreground="#2F3640" Margin="0,0,0,10"/>
                <ListBox x:Name="lstMahasiswa" Height="420" BorderBrush="#DCDDE1" Background="#FAFBFC">
                    <!-- Data akan masuk ke sini via C# -->
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</Window>
